# J.A.R.V.I.S. Optional Configuration
# Rename this file to .env to enable additional cloud LLM features.
# JARVIS works 100% out of the box with offline built-in intelligence and edge-tts!

# Optional: Google Gemini API Key for deep reasoning / open-ended questions
GEMINI_API_KEY=

# Optional: OpenAI API Key
OPENAI_API_KEY=

# Default Voice configuration (Microsoft Neural Voices)
# Options: en-GB-RyanNeural (Jarvis Default), en-GB-SoniaNeural, en-US-GuyNeural
JARVIS_VOICE=en-GB-RyanNeural
